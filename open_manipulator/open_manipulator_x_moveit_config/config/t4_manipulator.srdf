<?xml version="1.0" encoding="UTF-8"?>
<robot name="open_manipulator_x">

    <group name="arm">
        <joint name="virtual_joint"/>
        <joint name="joint1"/>
        <joint name="joint2"/>
        <joint name="joint3"/>
        <joint name="joint4"/>
        <joint name="end_effector_joint"/>
    </group>

    <group name="gripper">
        <joint name="gripper_left_joint"/>
        <joint name="gripper_right_joint"/>
    </group>

    <group_state name="init" group="arm">
        <joint name="joint1" value="0"/>
        <joint name="joint2" value="0"/>
        <joint name="joint3" value="0"/>
        <joint name="joint4" value="0"/>
    </group_state>
    <group_state name="home" group="arm">
        <joint name="joint1" value="0.035"/>
        <joint name="joint2" value="-1.43"/>
        <joint name="joint3" value="0.28"/>
        <joint name="joint4" value="1.73"/>
    </group_state>
    <group_state name="open" group="gripper">
        <joint name="gripper_left_joint" value="0.017"/>
    </group_state>
    <group_state name="close" group="gripper">
        <joint name="gripper_left_joint" value="0.01"/>
    </group_state>

    <end_effector name="end_effector_link" parent_link="end_effector_link" group="gripper"/>

    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>

    <passive_joint name="gripper_right_joint"/>

    <disable_collisions link1="gripper_left_link" link2="gripper_right_link" reason="Never"/>
    <disable_collisions link1="gripper_left_link" link2="link4" reason="Never"/>
    <disable_collisions link1="gripper_left_link" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="gripper_right_link" link2="link4" reason="Never"/>
    <disable_collisions link1="gripper_right_link" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link3" reason="Never"/>
    <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
    <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="tower_sensor_plate" reason="Adjacent"/>
    <disable_collisions link1="link5" link2="arm_link" reason="Never"/>
    <disable_collisions link1="link4" link2="arm_link" reason="Never"/>
    <disable_collisions link1="link3" link2="arm_link" reason="Never"/>
    <disable_collisions link1="link2" link2="arm_link" reason="Never"/>
    <disable_collisions link1="link1" link2="arm_link" reason="Never"/>
    <disable_collisions link1="gripper_left_link" link2="arm_link" reason="Never"/>
    <disable_collisions link1="gripper_right_link" link2="arm_link" reason="Never"/>
    <disable_collisions link1="link2" link2="tower_sensor_plate" reason="Never"/>
    <disable_collisions link1="link1" link2="tower_standoff_fl" reason="Never"/>
    <disable_collisions link1="link1" link2="tower_standoff_fr" reason="Never"/>
    <disable_collisions link1="link1" link2="tower_standoff_rl" reason="Never"/>
    <disable_collisions link1="link1" link2="tower_standoff_rr" reason="Never"/>

</robot>
